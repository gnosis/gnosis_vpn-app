{{!-- Copy of tauri-bundler's freedesktop/main.desktop; only Categories differs (Utility lands in "Accessories"). --}}
[Desktop Entry]
Categories=Network;Security;
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}}
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
