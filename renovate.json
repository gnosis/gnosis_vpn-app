{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:earlyMondays"],
  "baseBranchPatterns": ["main", "/^release\\/.*/"],
  "useBaseBranchConfig": "merge",
  "pinDigests": true,
  "prCreation": "immediate",
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "vulnerabilityAlerts": { "enabled": true },
  "minimumReleaseAge": "14 days",
  "nix": { "enabled": true },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "commitMessageTopic": "GitHub Actions"
    },
    {
      "matchManagers": ["nix"],
      "groupName": "nix flake updates",
      "pinDigests": false
    },
    {
      "description": "Disable gnosis_vpn-client git ref bumps — updated manually",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["gnosis_vpn-lib"],
      "enabled": false
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch"],
      "groupName": "rust crates (patch)"
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor"],
      "groupName": "rust crates (minor)"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "groupName": "npm packages (patch)"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "groupName": "npm packages (minor)"
    },
    {
      "description": "This is an app, not a library: exact versions keep in-range drift from bypassing minimumReleaseAge",
      "matchManagers": ["npm"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Tauri npm packages and Rust crates must stay on the same minor, so bump them together",
      "matchPackageNames": [
        "@tauri-apps/**",
        "tauri",
        "tauri-build",
        "tauri-plugin-**"
      ],
      "groupName": "tauri"
    }
  ]
}
